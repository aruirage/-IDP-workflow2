                    { text: '非浸潤性膀胱が', textStyle: { color: '#E31B54', bold: true, textAlign: 'center' } },
                    { text: 'ん', textStyle: { color: '#E31B54', bold: true, textAlign: 'center' } },
                    { text: '非浸潤性膀胱がん', textStyle: { textAlign: 'center' } },
