                    { text: '8', textStyle: { color: '#E31B54', bold: true, textAlign: 'center', fontFamily: "'SF Mono', Menlo, monospace" }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '882', textStyle: { color: '#E31B54', bold: true, textAlign: 'center', fontFamily: "'SF Mono', Menlo, monospace" }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '8882', textStyle: { textAlign: 'center' }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '6.手術1 手術コード', cellStyle: { background: { color: '#E8EEF9' } } },
                ],
                [
