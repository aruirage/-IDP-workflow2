                [
                    { text: '塚原明夫', cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: 'たかだウロ', textStyle: { color: '#E31B54', bold: true, textAlign: 'center' }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: 'クリニック', textStyle: { color: '#E31B54', bold: true, textAlign: 'center' }, cellStyle: { background: { color: '#E8EEF9' } } },
