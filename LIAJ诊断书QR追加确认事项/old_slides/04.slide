                    { text: '20', textStyle: { color: '#E31B54', bold: true, textAlign: 'center', fontFamily: "'SF Mono', Menlo, monospace" }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '26', textStyle: { color: '#E31B54', bold: true, textAlign: 'center', fontFamily: "'SF Mono', Menlo, monospace" }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '2026', textStyle: { textAlign: 'center' }, cellStyle: { background: { color: '#E8EEF9' } } },
                    { text: '3.入院期間①開始_年', cellStyle: { background: { color: '#E8EEF9' } } },
                ],
