                <Box style={{ width: 48, height: 44, background: '#175CD3', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>6</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ height: 112, flexDirection: 'row', alignItems: 'center', gap: 24, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '0 26px' }}>
            <Box style={{ width: 372, flexDirection: 'column' }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#6B7280' }}>B 案　代替案</Text>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#111827', marginTop: 6 }}>
