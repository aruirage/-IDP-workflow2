                <Box style={{ width: 48, height: 44, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#6B7280' }}>3</Text>
                </Box>
                <Box style={{ width: 48, height: 44, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
